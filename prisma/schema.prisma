// Wedding HQ schema.
//
// House rules (see CLAUDE.md):
// - Money is integer cents (Int). Never floats.
// - Calendar dates (due dates, paid dates, deadlines) are Postgres `date` (@db.Date), read and
//   written through src/lib/dates.ts so they never shift a day.
// - Real instants (createdAt, appointments) are timestamptz.
// - Anything derivable is derived. No paid / remaining / status-of-a-sum columns.
// - `seedKey` marks rows created by the real seed so re-running it never duplicates or overwrites.
// - `isDemo` marks demo rows so they can be wiped in one step.
// Extra constraints that Prisma can't express live in the migration SQL (CHECKs, partial indexes).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Settings & auth ───────────────────────────────────────────────────────────

/// Exactly one row (id = 1, enforced by a CHECK constraint).
model WeddingSettings {
  id                              Int      @id @default(1)
  partnerOneName                  String
  partnerTwoName                  String
  weddingDate                     DateTime @db.Date
  /// Wedding-day local time, "HH:MM".
  ceremonyTime                    String?
  timezone                        String   @default("America/New_York")
  venueName                       String
  venueAddress                    String
  /// Earliest vendor/setup arrival on the wedding day, "HH:MM".
  venueAccessTime                 String   @default("06:00")
  /// Planned number of people eating, including the couple and wedding party.
  /// Used until a guest list exists.
  headcountTarget                 Int      @default(125)
  totalBudgetCents                Int
  includedHeadcount               Int      @default(125)
  perPersonOverageCents           Int      @default(20000)
  /// Tax/service applied to the headcount overage, in parts per million (6.625% = 66250).
  overageTaxPpm                   Int      @default(0)
  /// Conservative default until the venue confirms.
  vendorMealsCountTowardHeadcount Boolean  @default(true)
  dressSizingDeadline             DateTime @db.Date
  heroImageUrl                    String?
  /// What happens if it rains: where the ceremony moves, who decides, by when.
  rainPlan                        String?
  createdAt                       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime @updatedAt @db.Timestamptz(3)
}

/// Exactly one row. Bumping sessionEpoch signs out every device.
model AuthState {
  id           Int      @id @default(1)
  sessionEpoch Int      @default(1)
  /// Secret path segment for the calendar subscription feed.
  icsToken     String
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model LoginAttempt {
  id Int      @id @default(autoincrement())
  ip String
  ok Boolean
  at DateTime @default(now()) @db.Timestamptz(3)

  @@index([at])
  @@index([ip, at])
}

// ─── Money ─────────────────────────────────────────────────────────────────────

model BudgetCategory {
  id            String       @id @default(cuid())
  name          String       @unique
  estimateCents Int
  sortOrder     Int
  /// Exactly one category is the contingency buffer (partial unique index).
  isContingency Boolean      @default(false)
  /// Closed categories return their unspent estimate to the contingency.
  isClosed      Boolean      @default(false)
  notes         String?
  seedKey       String?      @unique
  items         BudgetItem[]
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
}

model BudgetItem {
  id              String         @id @default(cuid())
  categoryId      String
  category        BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId        String?
  vendor          Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  description     String
  estimateCents   Int?
  contractedCents Int?
  notes           String?
  isDemo          Boolean        @default(false)
  seedKey         String?        @unique
  payments        Payment[]
  decisions       Decision[]
  decorItems      DecorItem[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([vendorId])
}

/// The spine of the app: paid, remaining and next-due are always derived from these rows.
model Payment {
  id           String         @id @default(cuid())
  budgetItemId String
  budgetItem   BudgetItem     @relation(fields: [budgetItemId], references: [id], onDelete: Restrict)
  /// Display order within the item ("2 of 6").
  sequence     Int?
  kind         PaymentKind
  /// Null means the amount isn't known yet (or is computed by amountRule until paid).
  amountCents  Int?
  amountRule   AmountRule?
  isEstimate   Boolean        @default(false)
  dueDate      DateTime       @db.Date
  paidDate     DateTime?      @db.Date
  method       PaymentMethod?
  reference    String?
  notes        String?
  isDemo       Boolean        @default(false)
  seedKey      String?        @unique
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  @@index([budgetItemId])
  @@index([dueDate])
}

enum PaymentKind {
  DEPOSIT
  INSTALLMENT
  FINAL
  OVERAGE
  /// Mandatory service charge (e.g. the maître d' fee). Never counted again as a tip.
  SERVICE_CHARGE
  /// Discretionary tip.
  GRATUITY
  OTHER
}

enum AmountRule {
  /// (headcount − includedHeadcount) × perPersonOverageCents, plus overageTaxPpm.
  HEADCOUNT_OVERAGE
}

enum PaymentMethod {
  CHECK
  CARD
  ACH
  WIRE
  ZELLE
  CASH
  OTHER
}

// ─── Vendors ───────────────────────────────────────────────────────────────────

model Vendor {
  id               String           @id @default(cuid())
  name             String
  category         VendorCategory
  /// Other categories this vendor covers (an all-inclusive venue may cover CATERING).
  alsoCovers       VendorCategory[] @default([])
  status           VendorStatus     @default(RESEARCHING)
  contactName      String?
  email            String?
  phone            String?
  website          String?
  instagram        String?
  /// Quote before booking. The contracted amount is derived from the vendor's budget items.
  quotedCents      Int?
  contractSignedOn DateTime?        @db.Date
  contractUrl      String?
  /// Wedding-day arrival, "HH:MM".
  arrivalTime      String?
  mealsRequired    Int              @default(0)
  notes            String?
  isDemo           Boolean          @default(false)
  seedKey          String?          @unique
  budgetItems      BudgetItem[]
  tasks            Task[]
  events           CalendarEvent[]
  questions        VendorQuestion[]
  log              VendorNote[]
  decisions        Decision[]
  timelineItems    TimelineItem[]
  decorItems       DecorItem[]
  hotelBlocks      HotelBlock[]
  shuttleRuns      ShuttleRun[]
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([category])
  @@index([status])
}

enum VendorCategory {
  VENUE
  CATERING
  PHOTOGRAPHY
  VIDEOGRAPHY
  FLORAL
  MUSIC_DJ
  MUSIC_CEREMONY
  CAKE
  ATTIRE
  BEAUTY
  STATIONERY
  RENTALS
  TRANSPORT
  OFFICIANT
  LODGING
  OTHER
}

enum VendorStatus {
  RESEARCHING
  CONTACTED
  QUOTED
  BOOKED
  DECLINED
  CANCELLED
}

/// "Questions to ask" checklist per vendor.
model VendorQuestion {
  id         String    @id @default(cuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  text       String
  answer     String?
  answeredOn DateTime? @db.Date
  sortOrder  Int       @default(0)
  seedKey    String?   @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([vendorId])
}

/// Timestamped communication log per vendor.
model VendorNote {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  at        DateTime @default(now()) @db.Timestamptz(3)
  author    Partner
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([vendorId, at])
}

// ─── Tasks & calendar ──────────────────────────────────────────────────────────

model Task {
  id            String              @id @default(cuid())
  title         String
  notes         String?
  dueDate       DateTime?           @db.Date
  owner         Owner               @default(BOTH)
  status        TaskStatus          @default(NOT_STARTED)
  priority      Priority            @default(MEDIUM)
  area          TaskArea            @default(PLANNING)
  vendorId      String?
  vendor        Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Set for wedding-party duties.
  partyMemberId String?
  partyMember   WeddingPartyMember? @relation(fields: [partyMemberId], references: [id], onDelete: SetNull)
  isMilestone   Boolean             @default(false)
  /// Set exactly when status is DONE (CHECK constraint).
  completedAt   DateTime?           @db.Timestamptz(3)
  isDemo        Boolean             @default(false)
  seedKey       String?             @unique
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@index([dueDate])
  @@index([status])
}

enum Owner {
  RONDELL
  CAPRI
  BOTH
  VENDOR
  WEDDING_PARTY
}

enum Partner {
  RONDELL
  CAPRI
  BOTH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskArea {
  PLANNING
  BUDGET
  VENUE
  VENDORS
  ATTIRE
  WEDDING_PARTY
  GUESTS
  STATIONERY
  CEREMONY
  RECEPTION
  BEAUTY
  TRAVEL
  LEGAL
  DAY_OF
  OTHER
}

/// Either a timed event (startAt/endAt) or an all-day event (allDayDate). Never both (CHECK).
model CalendarEvent {
  id         String    @id @default(cuid())
  title      String
  type       EventType
  startAt    DateTime? @db.Timestamptz(3)
  endAt      DateTime? @db.Timestamptz(3)
  allDayDate DateTime? @db.Date
  location   String?
  vendorId   String?
  vendor     Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes      String?
  isDemo     Boolean   @default(false)
  seedKey    String?   @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([startAt])
  @@index([allDayDate])
}

enum EventType {
  TASTING
  FITTING
  MEETING
  SITE_VISIT
  APPOINTMENT
  DEADLINE
  OTHER
}

// ─── Wedding party ─────────────────────────────────────────────────────────────

model WeddingPartyMember {
  id                   String        @id @default(cuid())
  /// Blank until we fill it in; the UI shows "Bridesmaid 1" etc.
  name                 String?
  side                 PartySide
  role                 PartyRole
  /// Drives the attire flow (the bridesman wears a suit on the bride's side).
  outfitType           OutfitType
  sortOrder            Int
  email                String?
  phone                String?
  /// Link to their guest row so they're seated and counted (not set by the CSV import yet).
  guestId              String?       @unique
  guest                Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  askedOn              DateTime?     @db.Date
  acceptedOn           DateTime?     @db.Date
  /// Dress style. Its menu must match the member's role (A bridesmaids, B honor attendants).
  chosenStyleId        String?
  chosenStyle          AttireOption? @relation("ChosenStyle", fields: [chosenStyleId], references: [id], onDelete: SetNull)
  // Attire progress. The status shown in the app is derived from the latest step with a date.
  sizingSubmittedOn    DateTime?     @db.Date
  orderedOn            DateTime?     @db.Date
  arrivedOn            DateTime?     @db.Date
  alteredOn            DateTime?     @db.Date
  readyOn              DateTime?     @db.Date
  sizes                Json?
  /// Suit wearers: rental paid. (Dress costs are tracked outside this app.)
  attirePaid           Boolean       @default(false)
  shoeOptionId         String?
  shoeOption           AttireOption? @relation("ShoeOption", fields: [shoeOptionId], references: [id], onDelete: SetNull)
  /// Already-owned shoes submitted for approval.
  shoeOwnedDescription String?
  shoeStatus           ShoeStatus    @default(NOT_SELECTED)
  hairPlan             String?
  accessoriesConfirmed Boolean       @default(false)
  giftIdea             String?
  giftPurchased        Boolean       @default(false)
  lodgingBooked        Boolean       @default(false)
  notes                String?
  seedKey              String?       @unique
  duties               Task[]
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
}

enum PartySide {
  BRIDE_SIDE
  GROOM_SIDE
}

enum PartyRole {
  BEST_MAN
  MAID_OF_HONOR
  MATRON_OF_HONOR
  GROOMSMAN
  BRIDESMAID
  BRIDESMAN
  OTHER
}

enum OutfitType {
  DRESS
  SUIT
}

enum ShoeStatus {
  NOT_SELECTED
  SELECTED
  SUBMITTED
  APPROVED
  REJECTED
}

/// Reference data for the dress and shoe menus.
model AttireOption {
  id          String               @id @default(cuid())
  menu        AttireMenu
  name        String
  description String
  color       String
  active      Boolean              @default(true)
  sortOrder   Int                  @default(0)
  seedKey     String?              @unique
  chosenBy    WeddingPartyMember[] @relation("ChosenStyle")
  shoesFor    WeddingPartyMember[] @relation("ShoeOption")
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([menu, name])
}

enum AttireMenu {
  A
  B
  SHOES
}

// ─── Guests & seating ──────────────────────────────────────────────────────────

model Guest {
  id             String              @id @default(cuid())
  fullName       String
  householdName  String
  side           GuestSide
  relationship   Relationship        @default(OTHER)
  isChild        Boolean             @default(false)
  plusOneOfId    String?
  plusOneOf      Guest?              @relation("PlusOne", fields: [plusOneOfId], references: [id], onDelete: SetNull)
  plusOnes       Guest[]             @relation("PlusOne")
  /// Imported from the RSVP app. Null means we don't know yet.
  rsvpStatus     RsvpStatus?
  mealChoice     String?
  dietaryNotes   String?
  notes          String?
  /// The RSVP app's own guest ID, when its export has one. Preferred match key on re-import.
  externalId     String?             @unique
  /// Normalized name + household, the fallback match key on re-import.
  matchKey       String
  lastImportedAt DateTime?           @db.Timestamptz(3)
  isDemo         Boolean             @default(false)
  seat           SeatAssignment?
  partyMember    WeddingPartyMember?
  gifts          Gift[]
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  @@index([matchKey])
  @@index([householdName])
}

enum GuestSide {
  BRIDE_SIDE
  GROOM_SIDE
  BOTH
}

/// Who the guest is to us. Children and plus-ones are flags, not relationships.
enum Relationship {
  COUPLE
  FAMILY
  FRIEND
  WORK
  OTHER
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
}

/// Remembers the last column mapping so re-imports take two clicks.
model GuestImport {
  id       String   @id @default(cuid())
  at       DateTime @default(now()) @db.Timestamptz(3)
  fileName String?
  mapping  Json
  summary  Json
}

model SeatingTable {
  id          String           @id @default(cuid())
  label       String
  shape       TableShape       @default(ROUND)
  capacity    Int
  x           Float            @default(0)
  y           Float            @default(0)
  rotation    Int              @default(0)
  sortOrder   Int              @default(0)
  isDemo      Boolean          @default(false)
  assignments SeatAssignment[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
}

enum TableShape {
  ROUND
  RECTANGLE
  SWEETHEART
  HEAD_TABLE
}

/// A guest sits at no more than one table (unique guestId).
model SeatAssignment {
  id         String       @id @default(cuid())
  guestId    String       @unique
  guest      Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  tableId    String
  table      SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatNumber Int?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([tableId, seatNumber])
  @@index([tableId])
}

// ─── Decision log ──────────────────────────────────────────────────────────────

model Decision {
  id           String      @id @default(cuid())
  decidedOn    DateTime    @db.Date
  title        String
  decision     String
  rationale    String?
  decidedBy    Partner
  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  budgetItemId String?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  isDemo       Boolean     @default(false)
  seedKey      String?     @unique
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
}

// ─── Wedding day: run of show ─────────────────────────────────────────────────

/// One line of the run of show for the rehearsal day, the wedding day or the day after.
/// Times are "HH:MM" wall-clock strings in the wedding's time zone, never instants.
model TimelineItem {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String
  endTime   String?
  title     String
  location  String?
  /// Who runs this moment: a name or a role ("Coordinator", "DJ").
  lead      String?
  /// Who needs to be there ("Wedding party, parents").
  involves  String?
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes     String?
  isDemo    Boolean  @default(false)
  seedKey   String?  @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([date, startTime])
}

// ─── Wedding day: music ───────────────────────────────────────────────────────

model SongRequest {
  id        String      @id @default(cuid())
  moment    MusicMoment
  title     String
  artist    String?
  notes     String?
  sortOrder Int         @default(0)
  isDemo    Boolean     @default(false)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  @@index([moment, sortOrder])
}

enum MusicMoment {
  PRELUDE
  PROCESSIONAL
  COUPLE_ENTRANCE
  BROOM_JUMP
  RECESSIONAL
  COCKTAIL_HOUR
  GRAND_ENTRANCE
  FIRST_DANCE
  PARENT_DANCE
  CAKE_CUTTING
  LAST_DANCE
  SEND_OFF
  MUST_PLAY
  DO_NOT_PLAY
}

/// Who walks down the aisle, in order.
model ProcessionalEntry {
  id        String   @id @default(cuid())
  sortOrder Int      @default(0)
  /// Who walks together ("Best man with maid of honor").
  walkers   String
  notes     String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ─── Wedding day: photos ──────────────────────────────────────────────────────

model ShotListItem {
  id          String     @id @default(cuid())
  moment      ShotMoment
  description String
  /// Everyone in the photo, so the photographer's assistant can gather them.
  people      String?
  isMustHave  Boolean    @default(false)
  sortOrder   Int        @default(0)
  isDemo      Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([moment, sortOrder])
}

enum ShotMoment {
  DETAILS
  GETTING_READY
  FIRST_LOOK
  CEREMONY
  FAMILY
  WEDDING_PARTY
  COUPLE
  COCKTAIL_HOUR
  RECEPTION
  OTHER
}

// ─── Design ───────────────────────────────────────────────────────────────────

/// Inspiration: a link to a picture or a page, grouped by area.
model InspirationItem {
  id         String     @id @default(cuid())
  area       DesignArea
  title      String?
  /// Direct link to an image, shown on the board.
  imageUrl   String?
  /// Where it came from (Pinterest, Instagram, a vendor's site).
  sourceUrl  String?
  notes      String?
  isFavorite Boolean    @default(false)
  sortOrder  Int        @default(0)
  isDemo     Boolean    @default(false)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  @@index([area, sortOrder])
}

enum DesignArea {
  OVERALL
  CEREMONY
  COCKTAIL_HOUR
  RECEPTION
  FLOWERS
  TABLESCAPE
  LIGHTING
  CAKE
  STATIONERY
  ATTIRE
  WELCOME
  OTHER
}

model PaletteColor {
  id        String   @id @default(cuid())
  name      String
  /// "#RRGGBB"
  hex       String
  /// Where it's used ("Menu A dresses", "Metals").
  usage     String?
  sortOrder Int      @default(0)
  isDemo    Boolean  @default(false)
  seedKey   String?  @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Décor, rentals and everything that has to arrive at the venue. Status comes from the dates.
model DecorItem {
  id           String      @id @default(cuid())
  name         String
  area         DesignArea
  quantity     Int         @default(1)
  source       DecorSource
  vendorId     String?
  vendor       Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// The money lives on the budget item and its payments, never here.
  budgetItemId String?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  orderedOn    DateTime?   @db.Date
  receivedOn   DateTime?   @db.Date
  /// Rentals and borrowed pieces: when they have to go back.
  returnBy     DateTime?   @db.Date
  returnedOn   DateTime?   @db.Date
  notes        String?
  sortOrder    Int         @default(0)
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([area, sortOrder])
}

enum DecorSource {
  VENUE
  VENDOR
  RENTAL
  PURCHASE
  DIY
  BORROWED
}

// ─── Guest care ───────────────────────────────────────────────────────────────

model HotelBlock {
  id               String    @id @default(cuid())
  name             String
  address          String?
  phone            String?
  bookingUrl       String?
  groupCode        String?
  roomsHeld        Int?
  nightlyRateCents Int?
  /// Last day guests can book at the group rate.
  cutoffDate       DateTime? @db.Date
  checkIn          DateTime? @db.Date
  checkOut         DateTime? @db.Date
  vendorId         String?
  vendor           Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes            String?
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
}

/// A shuttle or car run. Times are "HH:MM" wall-clock strings in the wedding's time zone.
model ShuttleRun {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  departTime String
  fromPlace  String
  toPlace    String
  seats      Int?
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes      String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([date, departTime])
}

model WelcomeBagItem {
  id         String    @id @default(cuid())
  name       String
  perBag     Int       @default(1)
  orderedOn  DateTime? @db.Date
  receivedOn DateTime? @db.Date
  notes      String?
  sortOrder  Int       @default(0)
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
}

/// A gift received. Whether a thank-you is still owed comes from thankYouSentOn.
model Gift {
  id             String    @id @default(cuid())
  fromName       String
  guestId        String?
  guest          Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  description    String
  receivedOn     DateTime  @db.Date
  thankYouSentOn DateTime? @db.Date
  notes          String?
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([receivedOn])
}
