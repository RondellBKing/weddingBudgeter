# Postgres connection string.
# Local:      postgresql://wedding:wedding@localhost:5432/wedding_hq
# Production: the pooled Neon URL that the Vercel integration adds.
DATABASE_URL=

# Base64-encoded argon2id hash of the shared passphrase.
# Generate it with: npm run hash-password
APP_PASSWORD_HASH=

# At least 32 random characters. Signs the session cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Only needed for the restore check (npm run restore -- --verify).
RESTORE_DATABASE_URL=
